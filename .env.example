# Copy this file to .env and fill in your values (local dev ke liye).
# Production/hosting pe inhe environment variables ke through set karo.

BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=123456789
ADMIN_IDS=111111111,222222222

SUPPORT_CHAT_URL=https://t.me/mysupportgroup
OWNER_URL=https://t.me/myusername
UPDATES_CHANNEL_URL=https://t.me/myupdateschannel
SOURCE_URL=https://github.com/myusername/zip-extractor-bot
BOT_USERNAME=MyZipExtractorBot

# Khali chhod do agar force-subscribe nahi chahiye
FORCE_SUB_CHANNEL=
FORCE_SUB_CHANNEL_URL=

LOG_CHANNEL_ID=

MAX_FILE_SIZE_MB=50
MAX_FILES_TO_SEND=100
MAX_EXTRACTED_SIZE_MB=500
MAX_QUEUE_PER_USER=5
MAX_CONCURRENT_EXTRACTIONS=3
RATE_LIMIT_SECONDS=10
PASSWORD_TIMEOUT_SECONDS=120

MONGO_URI=mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/
MONGO_DB_NAME=zip_extractor_bot
