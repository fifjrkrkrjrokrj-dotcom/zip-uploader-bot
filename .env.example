# Copy this file to .env and fill in your values (local dev ke liye).
# Production/hosting pe inhe environment variables ke through set karo.

BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pyrogram ko bot token ke saath API_ID / API_HASH bhi chahiye — free milta
# hai https://my.telegram.org se (apne personal Telegram account se login
# karke "API development tools" me jaao, 2 minute ka kaam hai).
API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef

OWNER_ID=123456789
ADMIN_IDS=111111111,222222222

SUPPORT_CHAT_URL=https://t.me/mysupportgroup
OWNER_URL=https://t.me/myusername
UPDATES_CHANNEL_URL=https://t.me/myupdateschannel
SOURCE_URL=https://github.com/myusername/zip-extractor-bot
BOT_USERNAME=MyZipExtractorBot

# Khali chhod do agar force-subscribe nahi chahiye
FORCE_SUB_CHANNEL=
FORCE_SUB_CHANNEL_URL=

# Activity feed / logs / backups sab yahan bhejte hain. Khali ho to
# seedha OWNER_ID ki DM me chala jaata hai.
LOG_CHANNEL_ID=

# Pyrogram MTProto directly use karta hai, isliye files 2GB (2000MB) tak
# seedha bhej/receive kar sakta hai — koi local Bot-API server nahi chahiye.
MAX_FILE_SIZE_MB=1000
MAX_FILES_TO_SEND=100
MAX_EXTRACTED_SIZE_MB=4000
MAX_QUEUE_PER_USER=5
MAX_CONCURRENT_EXTRACTIONS=3
RATE_LIMIT_SECONDS=10
PASSWORD_TIMEOUT_SECONDS=120

MONGO_URI=mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/
MONGO_DB_NAME=zip_extractor_bot

# ---------------- NESTED ARCHIVES ----------------
MAX_NESTED_DEPTH=3
MAX_NESTED_ARCHIVES=25

# ---------------- FILE TYPE BLACKLIST ----------------
BLACKLIST_EXTENSIONS=.exe,.bat,.cmd,.msi,.scr,.js,.vbs,.vbe,.ps1,.jar,.com,.dll,.sh,.apk,.jse,.wsf,.lnk

# ---------------- DUPLICATE DETECTION (dedup cache) ----------------
CACHE_ENABLED=true
CACHE_DIR=cache
CACHE_TTL_HOURS=72

# ---------------- USER TIERS (VIP / premium) ----------------
# Free tier ke defaults upar wale MAX_FILE_SIZE_MB / RATE_LIMIT_SECONDS /
# MAX_QUEUE_PER_USER se aate hain. VIP/premium ke apne overrides — NOTE:
# Telegram bot accounts ki hard ceiling ~2000MB hai, isse zyada set karne
# ka koi fayda nahi (automatically 2000 tak cap ho jaata hai).
VIP_MAX_FILE_SIZE_MB=2000
VIP_RATE_LIMIT_SECONDS=5
VIP_MAX_QUEUE=10
PREMIUM_MAX_FILE_SIZE_MB=2000
PREMIUM_RATE_LIMIT_SECONDS=0
PREMIUM_MAX_QUEUE=20

# ---------------- WEB DASHBOARD ----------------
DASHBOARD_ENABLED=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# ---------------- VIRUS SCAN (ClamAV) ----------------
# clamdscan/clamscan install hona chahiye server pe: apt install clamav clamav-daemon
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=false
CLAMAV_TIMEOUT_SECONDS=60
CLAMAV_SCAN_EXTRACTED=false

# ---------------- REDIS RATE-LIMIT ----------------
# Khali chhod do to in-memory fallback use hoga.
REDIS_URL=

# ---------------- AUTO MONGODB BACKUP ----------------
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_LOCAL=5

# ---------------- ADMIN ACTIVITY FEED ----------------
ADMIN_ACTIVITY_FEED=true

# ---------------- LANGUAGE ----------------
DEFAULT_LANGUAGE=hi
